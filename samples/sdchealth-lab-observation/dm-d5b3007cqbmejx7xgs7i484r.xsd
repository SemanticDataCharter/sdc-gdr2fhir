          <dcterms:source rdf:resource="https://www.xt-ehr.eu/fhir/models/1.0.0/"/>
        </rdf:Description>
      </xsd:appinfo>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:restriction base="sdc4:XdStringType">
